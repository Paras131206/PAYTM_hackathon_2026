# Copy to .env (repo root) and fill in. .env is git-ignored. Never commit real keys.

# Agent engine: auto | claude | gemini | rules
#   auto  -> claude if ANTHROPIC_API_KEY is set, else gemini if GEMINI_API_KEY is set, else rules
#            (decided once, when the backend starts)
#   rules -> deterministic keyword planner, no LLM calls
AGENT_ENGINE=auto

# Google Gemini (only needed for the gemini engine). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=90

# Anthropic (only needed for the claude engine)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT_S=90
# Server-side refusal fallback (beta). Set to 0 if your account/region rejects it.
ANTHROPIC_REFUSAL_FALLBACK=1

# Business rules
AUTO_REFUND_LIMIT_PAISE=200000
MAX_AGENT_TURNS=12
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BACKOFF_S=0.4

# Optional
# RESOLV_DB_PATH=backend/data/resolv.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
