# Copy to .env (repo root) and fill in. .env is git-ignored. Never commit real keys.

# Agent engine: auto | llm | rules
#   auto  -> llm if any provider below is configured, else rules (decided once, when the backend starts)
#   llm   -> LLM providers tried in LLM_PROVIDERS order; on a quota/timeout/outage the run moves to the next one
#   rules -> deterministic keyword planner, no LLM calls
AGENT_ENGINE=auto
LLM_PROVIDERS=gemini,groq,cerebras,ollama,claude

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (free tier): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Ollama (local, free, no key). Leave OLLAMA_MODEL empty to keep Ollama out of the chain.
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1

# Google Gemini (only needed for the gemini engine). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=90

# Anthropic (only needed for the claude engine)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT_S=90
# Server-side refusal fallback (beta). Set to 0 if your account/region rejects it.
ANTHROPIC_REFUSAL_FALLBACK=1

# Business rules
AUTO_REFUND_LIMIT_PAISE=200000
MAX_AGENT_TURNS=12
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BACKOFF_S=0.4

# Optional
# RESOLV_DB_PATH=backend/data/resolv.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
